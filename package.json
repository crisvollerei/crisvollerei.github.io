{
  "name": "qingzheng-schedule",
  "version": "2.0.0",
  "private": true,
  "description": "Dependency-free personal shift calendar",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "version:assets": "node scripts/version-assets.mjs",
    "build:offline": "node scripts/build-offline.mjs",
    "build": "npm run version:assets && npm run build:offline",
    "check": "node scripts/version-assets.mjs --check && node scripts/build-offline.mjs --check && npm test"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "jsdom": "29.1.1"
  },
  "type": "module"
}
